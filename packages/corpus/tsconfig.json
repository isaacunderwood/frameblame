{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Node, not the browser: this package exists to read files. It is the
    // deliberate counterpart to `packages/core`, whose tsconfig omits both
    // `node` and `DOM` so that reaching for either is a compile error there.
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["src", "vitest.config.ts"]
}
